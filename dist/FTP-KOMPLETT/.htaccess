# ============================================================
# SUI Innova GmbH — .htaccess (Hostpoint)
# ============================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ────────────────────────────────────────────────
    # Build-Verzeichnis sperren
    # Enthaelt Generatoren, SQL-Migrationen und Upload-Pakete. Gehoert
    # nicht auf den Server, ist aber ueber FTP dorthin gelangt. Als erste
    # Regel, damit kein spaeterer Treffer daran vorbeikommt.
    # ────────────────────────────────────────────────
    RewriteRule ^dist(/|$) - [F,L]

    # ────────────────────────────────────────────────
    # Eine kanonische Adresse: https, ohne www
    #
    # Frueher liefen das hier in zwei Regeln, und http://www brauchte
    # deshalb zwei Spruenge: erst auf https://www, dann auf https ohne
    # www. Jede zusaetzliche Weiterleitung kostet Ladezeit und ein
    # bisschen von dem, was ein Link an Gewicht weitergibt.
    #
    # Die erste Regel schreibt das Ziel jetzt fest hin statt
    # %{HTTP_HOST} zu uebernehmen. Damit landet http://www in einem
    # Schritt auf https://sui-innova.ch.
    # ────────────────────────────────────────────────
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://sui-innova.ch/$1 [R=301,L]

    # Bleibt fuer den Fall https://www, der die Regel oben nicht trifft.
    RewriteCond %{HTTP_HOST} ^www\.sui-innova\.ch$ [NC]
    RewriteRule ^(.*)$ https://sui-innova.ch/$1 [R=301,L]

    # ────────────────────────────────────────────────
    # 301-Redirects fuer alte URLs (aus Site-Migration)
    # Verhindert Traffic-Verlust und rettet Backlink-Autoritaet
    # ────────────────────────────────────────────────
    # Die Ziele stehen absolut mit https und ohne www. Mit einem
    # relativen Ziel baut Apache die Adresse aus dem auf, was es selbst
    # sieht, und hinter dem TLS-Abschluss von Hostpoint ist das http.
    # Jede dieser Umleitungen lief dann ueber zwei Spruenge: erst auf
    # http ohne www, dann von der Regel oben auf https.
    #
    # Zweite Startseite abschalten: /startseite lieferte denselben Inhalt
    # wie / und teilte damit die Autoritaet auf zwei Adressen auf.
    RewriteRule ^startseite/?$                                     https://sui-innova.ch/ [R=301,L]
    RewriteRule ^home/?$                                           https://sui-innova.ch/ [R=301,L]

    RewriteRule ^blog/?$                                           https://sui-innova.ch/ [R=301,L]
    RewriteRule ^dienstleistungen/?$                               https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^dienstleistungen/(.*)$                            https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^unternehmen/?$                                    https://sui-innova.ch/ueber-uns [R=301,L]
    RewriteRule ^montage-sanit(ae|ä)r-vorwandsysteme---gis-montagen/?$  https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^vorfabrikation/?$                                 https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^montage/?$                                        https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^aqua-?panel/?$                                    https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^beplankung(en)?/?$                                https://sui-innova.ch/leistungen [R=301,L]
    RewriteRule ^gis-elemente?/?$                                  https://sui-innova.ch/leistungen [R=301,L]

    # ────────────────────────────────────────────────
    # Trailing-Slash-Konsistenz (kein trailing slash)
    # Auch hier absolut, aus demselben Grund.
    # ────────────────────────────────────────────────
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ https://sui-innova.ch/$1 [R=301,L]

    # ────────────────────────────────────────────────
    # Statische Assets direkt ausliefern
    # ────────────────────────────────────────────────
    RewriteCond %{REQUEST_URI} ^/(assets|uploads)/
    RewriteRule ^ - [L]

    # robots.txt und sitemap.xml direkt
    RewriteRule ^robots\.txt$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap\.xml$ index.php?page=sitemap.xml [QSA,L]

    # ────────────────────────────────────────────────
    # Alles andere → index.php (Front-Controller)
    # ────────────────────────────────────────────────
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]
</IfModule>

# ────────────────────────────────────────────────
# Sicherheits-Header
# ────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ────────────────────────────────────────────────
# Sensible Dateien schuetzen
# ────────────────────────────────────────────────
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|log|sql)$">
    Require all denied
</FilesMatch>


# Config- und Core-PHP-Dateien nur ueber Front-Controller aufrufbar
<FilesMatch "^(config|bootstrap|db|helpers|auth|router|contact|application|sitemap)\.php$">
    <If "%{REQUEST_URI} =~ m#^/(config|core)/#">
        Require all denied
    </If>
</FilesMatch>

# ────────────────────────────────────────────────
# Caching fuer statische Assets
# ────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ────────────────────────────────────────────────
# Kompression (Text-Assets)
# ────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/xml application/json
    AddOutputFilterByType DEFLATE application/xml+rss image/svg+xml
</IfModule>

# ────────────────────────────────────────────────
# 404-Seite
# ────────────────────────────────────────────────
ErrorDocument 404 /index.php
